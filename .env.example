# Copy this file to `.env.local` and fill in your real values.
# NEVER commit `.env.local`.

# SMTP / email configuration (used by Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Store email that receives every new order notification
STORE_EMAIL=your-store-email@gmail.com

# Email sender shown to customers (can be a display name + address)
EMAIL_FROM="BIG DEAL <your-email@gmail.com>"

# ------------------------------------------------------------------
# Optional overrides (you can also edit these directly in lib/config.ts)
# ------------------------------------------------------------------

# UPI ID customers pay to when using "Pay via QR Code".
# NOTE: sirf UPI ID daalo (e.g. paytm.s23z1r0@pty), pura "upi://pay?..." link NAHI.
NEXT_PUBLIC_PAYMENT_UPI_ID=paytm.s23z1r0@pty

# Name shown on the UPI payment screen
# NEXT_PUBLIC_PAYMENT_NAME=BIG DEAL

# Optional static QR code image path (e.g. /qr-code.png).
# Empty rakho => QR automatically PAYMENT_UPI_ID + exact order amount se generate hoga.
NEXT_PUBLIC_PAYMENT_QR_CODE=

# Contact details shown in the footer / contact page (optional)
# STORE_PHONE=
# STORE_ADDRESS=
# STORE_WHATSAPP=

# For multi-instance / self-hosted deployments (optional, recommended in prod)
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=some-long-random-string

# ------------------------------------------------------------------
# Admin dashboard
# ------------------------------------------------------------------
# Admin login email / password (used by /admin login page)
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=your-strong-password

# Secret used to sign the admin session cookie (long random string)
ADMIN_SESSION_SECRET=some-long-random-secret-string
